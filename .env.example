# Server-side DeepSeek key used for the shared demo (visitors can also bring their own in Settings).
DEEPSEEK_API_KEY=

# Optional
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_THINKING=disabled          # "enabled" = slower, more careful plans
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Rate limits for the shared key
# RATE_LIMIT_PER_HOUR=40              # per IP
# RATE_LIMIT_GLOBAL_PER_DAY=3000

# Optional: durable rate limiting across serverless instances (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
